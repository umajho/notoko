+def read_lexicon(lex_path):
+    """Read lexicon file and return word-to-phones mapping."""
+    lexicon = {}
+    with open(lex_path) as f:
+        for line in f:
+            temp = re.split(r"\s+", line.strip("\n"))
+            word = temp[0]
+            phones = temp[1:]
+            if word.lower() not in lexicon:
+                lexicon[word.lower()] = phones
+    return lexicon
+
+
+def preprocess_english(text, preprocess_config, return_segments=False):
+    """Convert English text to phoneme sequence.
+    
+    Args:
+        text: Input English text
+        preprocess_config: Preprocessing configuration
+        return_segments: If True, return segmentation data for prosody JSON
+        
+    Returns:
+        If return_segments is False: numpy array of phoneme sequence
+        If return_segments is True: (numpy array, segments_data)
+            segments_data is a list of dicts with 'text' and 'phonemes' for each word/space
+    """
+    text = text.rstrip(punctuation)
+    lexicon = read_lexicon(preprocess_config["path"]["lexicon_path"])
+
+    g2p = G2p()
+    phones = []
+    segments_data = [] if return_segments else None
+    
+    words = re.split(r"([,;.\-\?\!\s+])", text)
+    for w in words:
+        word_phones = []
+        if w.lower() in lexicon:
+            word_phones = lexicon[w.lower()]
+        else:
+            word_phones = list(filter(lambda p: p != " ", g2p(w)))
+        
+        phones += word_phones
+        
+        # Track segmentation if requested
+        if return_segments:
+            if w.isspace() or not w.strip():
+                # Space segment
+                segments_data.append({
+                    "type": "space",
+                    "text": w,
+                    "phonemes": ["sp"]  # Will be replaced with actual sp phonemes
+                })
+            elif w:
+                segments_data.append({
+                    "type": "word",
+                    "text": w,
+                    "phonemes": word_phones
+                })
+    
+    phones = "{" + "}{".join(phones) + "}"
+    phones = re.sub(r"\{[^\w\s]?\}", "{sp}", phones)
+    phones = phones.replace("}{", " ")
+
+    print("Raw Text Sequence: {}".format(text))
+    print("Phoneme Sequence: {}".format(phones))
+    sequence = np.array(
+        text_to_sequence(
+            phones, preprocess_config["preprocessing"]["text"]["text_cleaners"]
+        )
+    )
+
+    if return_segments:
+        return np.array(sequence), segments_data
+    return np.array(sequence)
+
+
+def preprocess_mandarin(text, preprocess_config, return_segments=False):
+    """Convert Mandarin Chinese text to phoneme sequence.
+    
+    Args:
+        text: Input Mandarin Chinese text
+        preprocess_config: Preprocessing configuration
+        return_segments: If True, return segmentation data for prosody JSON
+        
+    Returns:
+        If return_segments is False: numpy array of phoneme sequence
+        If return_segments is True: (numpy array, segments_data)
+            segments_data is a list of dicts with 'text' and 'phonemes' for each character/space
+    """
+    lexicon = read_lexicon(preprocess_config["path"]["lexicon_path"])
+
+    phones = []
+    segments_data = [] if return_segments else None
+    
+    pinyins = [
+        p[0]
+        for p in pinyin(
+            text, style=Style.TONE3, strict=False, neutral_tone_with_five=True
+        )
+    ]
+    
+    char_idx = 0
+    for char in text:
+        char_phones = []
+        
+        if char.isspace():
+            # Space character
+            char_phones = ["sp"]
+            if return_segments:
+                segments_data.append({
+                    "type": "space",
+                    "text": char,
+                    "phonemes": char_phones
+                })
+        else:
+            # Regular character - get its pinyin and phonemes
+            if char_idx < len(pinyins):
+                p = pinyins[char_idx]
+                char_idx += 1
+                
+                if p in lexicon:
+                    char_phones = lexicon[p]
+                else:
+                    char_phones = ["sp"]
+                
+                if return_segments:
+                    segments_data.append({
+                        "type": "character",
+                        "text": char,
+                        "pinyin": p,
+                        "phonemes": char_phones
+                    })
+        
+        phones += char_phones
+
+    phones = "{" + " ".join(phones) + "}"
+    print("Raw Text Sequence: {}".format(text))
+    print("Phoneme Sequence: {}".format(phones))
+    sequence = np.array(
+        text_to_sequence(
+            phones, preprocess_config["preprocessing"]["text"]["text_cleaners"]
+        )
+    )
+
+    if return_segments:
+        return np.array(sequence), segments_data
+    return np.array(sequence)
+

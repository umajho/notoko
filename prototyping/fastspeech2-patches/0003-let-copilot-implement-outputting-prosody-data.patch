+def generate_prosody_json(raw_text, phonemes, durations, actual_pitch, hop_length, sampling_rate, segments_data):
+    """
+    Generate prosody JSON data structure from text, phonemes, durations and pitch.
+    
+    Args:
+        raw_text: Original input text (e.g., "大家好")
+        phonemes: List of phoneme symbols (e.g., ["d", "a4", "j", "ia1", ...])
+        durations: Duration for each phoneme in frames
+        actual_pitch: Actual pitch contour extracted from audio
+        hop_length: STFT hop length
+        sampling_rate: Audio sampling rate
+        segments_data: List of segment dicts from preprocess_mandarin/preprocess_english
+                       Each dict has 'type', 'text', and 'phonemes'
+    
+    Returns:
+        Dictionary with prosody data in the specified format
+    """
+    segments = []
+    phoneme_idx = 0
+    
+    # Process each segment from the preprocessing
+    for segment in segments_data:
+        if segment["type"] == "space":
+            # Space segment
+            space_duration = 0
+            # Consume phonemes for this space
+            for _ in range(len(segment["phonemes"])):
+                if phoneme_idx < len(phonemes):
+                    space_duration += int(durations[phoneme_idx] * hop_length)
+                    phoneme_idx += 1
+            
+            if space_duration > 0:
+                segments.append({
+                    "type": "space",
+                    "durationTicks": space_duration
+                })
+        else:
+            # Character or word segment
+            char_phonemes = []
+            char_duration_ticks = 0
+            
+            # Consume phonemes for this character/word
+            for phon in segment["phonemes"]:
+                if phoneme_idx < len(phonemes):
+                    dur_ticks = int(durations[phoneme_idx] * hop_length)
+                    
+                    char_phonemes.append({
+                        "phoneme": phonemes[phoneme_idx].replace('@', ''),
+                        "durationTicks": dur_ticks
+                    })
+                    
+                    char_duration_ticks += dur_ticks
+                    phoneme_idx += 1
+            
+            # Remove durationTicks from the last phoneme (as per spec)
+            if char_phonemes:
+                del char_phonemes[-1]["durationTicks"]
+            
+            # Add character/word segment
+            if char_phonemes:
+                segments.append({
+                    "text": segment["text"],
+                    "durationTicks": char_duration_ticks,
+                    "phonemes": char_phonemes
+                })
+    
+    # Prepare actual pitch data
+    ticks_per_point = hop_length
+    pitch_points = [float(p) for p in actual_pitch]
+    
+    prosody_data = {
+        "inputText": raw_text,
+        "ticksPerSecond": sampling_rate,
+        "segments": segments,
+        "actualPitches": {
+            "ticksPerPoint": ticks_per_point,
+            "points": pitch_points
+        }
+    }
+    
+    return prosody_data
+
+

+def extract_pitch_from_audio(wav, sampling_rate, hop_length):
+    """
+    Extract F0 (pitch) from audio waveform using PyWorld.
+    
+    Args:
+        wav: Audio waveform (numpy array)
+        sampling_rate: Sampling rate of the audio
+        hop_length: Hop length for STFT
+    
+    Returns:
+        pitch: F0 contour (numpy array)
+    """
+    pitch, t = pw.dio(
+        wav.astype(np.float64),
+        sampling_rate,
+        frame_period=hop_length / sampling_rate * 1000,
+    )
+    pitch = pw.stonemask(wav.astype(np.float64), pitch, t, sampling_rate)
+    
+    # Perform linear interpolation for unvoiced regions
+    nonzero_ids = np.where(pitch != 0)[0]
+    if len(nonzero_ids) > 1:
+        interp_fn = interp1d(
+            nonzero_ids,
+            pitch[nonzero_ids],
+            fill_value=(pitch[nonzero_ids[0]], pitch[nonzero_ids[-1]]),
+            bounds_error=False,
+        )
+        pitch = interp_fn(np.arange(0, len(pitch)))
+    
+    return pitch
+

+def duration_result_to_tensor(duration_result: DurationResult) -> torch.Tensor:
+    """Convert DurationResult to tensor format expected by model.
+    
+    Args:
+        duration_result: DurationResult with durations_2d structure
+        
+    Returns:
+        Tensor of shape [1, total_phonemes] containing duration values
+    """
+    # Flatten the 2D duration structure into 1D array
+    durations_flat = []
+    for segment_durations in duration_result.durations_2d:
+        durations_flat.extend(segment_durations)
+    
+    # Convert to tensor [1, num_phonemes]
+    duration_tensor = torch.LongTensor([durations_flat]).to(device)
+    
+    return duration_tensor
+
+
 def extract_duration_from_output(
     output: tuple[Any, ...],
     phonemize_result: PhonemizeResult,

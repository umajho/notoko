--- /dev/null
+++ b/refactoring/instructions/3.md
@@ -0,0 +1,61 @@
+# 1
+
+Change the response of `POST /predict_duration` from like:
+
+```json
+["ok", {
+  "ticksPerSecond": 22050,
+  "durationUnitInTicks": 256,
+  "durations2d": [[123, 456], [789, 234], [567], [891, 345], [678, 912]]
+}]
+```
+
+to like:
+
+```json
+["ok", {
+  "ticksPerSecond": 22050,
+  "durationTicks2d": [[123 * 256, 456 * 256], [789 * 256, 234 * 256], [567 * 256], [891 * 256, 345 * 256], [678 * 256, 912 * 256]]
+}]
+```
+
+# 2
+
+Change the request of `POST /generate_prosody` from like:
+
+```json
+{
+  "language": {
+    "iso-639": "cmn",
+    "segmentation_format": "fastspeech2-pinyin-r?tones"
+  },
+  "segments": [
+    { "text": "你", "phonemes": ["n", "i3"] },
+    { "text": "好", "phonemes": ["h", "ao3"] },
+    { "text": "，", "phonemes": ["sp"] },
+    { "text": "世", "phonemes": ["sh", "iii4"] },
+    { "text": "界", "phonemes": ["j", "ie4"] }
+  ],
+  "durations2d": [[123, 456], [789, 234], [567], [891, 345], [678, 912]]
+}
+```
+
+to like:
+
+```json
+{
+  "language": {
+    "iso-639": "cmn",
+    "segmentation_format": "fastspeech2-pinyin-r?tones"
+  },
+  "segments": [
+    { "text": "你", "phonemes": ["n", "i3"] },
+    { "text": "好", "phonemes": ["h", "ao3"] },
+    { "text": "，", "phonemes": ["sp"] },
+    { "text": "世", "phonemes": ["sh", "iii4"] },
+    { "text": "界", "phonemes": ["j", "ie4"] }
+  ],
+  "ticksPerSecond": 22050,
+  "durationTicks2d": [[123 * 256, 456 * 256], [789 * 256, 234 * 256], [567 * 256], [891 * 256, 345 * 256], [678 * 256, 912 * 256]]
+}
+```

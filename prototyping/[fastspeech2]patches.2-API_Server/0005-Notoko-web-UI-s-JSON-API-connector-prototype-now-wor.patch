+@app.route("/info", methods=["GET"])
+def get_info():
+    """Get information about available duration predictors and prosody generators."""
+    try:
+        info = {
+            "shownName": "FastSpeech2 Patched Prototype",
+            "durationPredictors": {},
+            "prosodyGenerators": {}
+        }
+        
+        # Build info from service_config_map
+        for lang_code, config in service_config_map.items():
+            key = f"{config['iso639_3']}.{config['dataset_name'].lower()}"
+            iso639_3 = config["iso639_3"]
+            segmentation_formats = get_segmentation_formats(iso639_3)
+            
+            # Build configuration schema based on whether model has multiple speakers
+            has_multiple_speakers = "max_speaker_id" in config
+            if has_multiple_speakers:
+                config_schema = ["json_schema", {
+                    "$schema": "https://json-schema.org/draft-07/schema#",
+                    "type": "object",
+                    "required": ["speakerId"],
+                    "properties": {
+                        "speakerId": {
+                            "type": "integer",
+                            "minimum": 0,
+                            "maximum": config["max_speaker_id"]
+                        }
+                    }
+                }]
+                default_config = {"speakerId": config.get("speaker_id", 0)}
+            else:
+                config_schema = ["json_schema", {
+                    "$schema": "https://json-schema.org/draft-07/schema#",
+                    "type": "object"
+                }]
+                default_config = {}
+            
+            supported_input_languages = [{
+                "iso639-3": iso639_3,
+                "segmentationFormatsRanked": segmentation_formats
+            }]
+
+            # Build duration predictor info
+            duration_predictor = {
+                "shownName": config["shown_name"],
+                "supportedInputLanguages": supported_input_languages,
+                "configurationSchema": config_schema,
+                "defaultConfiguration": default_config
+            }
+            info["durationPredictors"][key] = duration_predictor
+            
+            # Build prosody generator info
+            prosody_generator = {
+                "shownName": config["shown_name"],
+                "supportedInputLanguages": supported_input_languages,
+                "durationInput": "optional",
+                "configurationSchema": config_schema,
+                "defaultConfiguration": default_config
+            }
+            info["prosodyGenerators"][key] = prosody_generator
+        
+        return jsonify(info), 200
+        
+    except Exception as e:
+        return jsonify(["error", {"message": f"internal error: {str(e)}"}]), 500
+
+
 def initialize_service(config_map: dict[str, dict[str, Any]]):
     """Initialize the inference service with configuration."""
-    global inference_service

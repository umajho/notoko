+            "speaker_id": config.get("speaker_id", 0),
+            "restore_step": config["restore_step"],
+            "p": config["p"],
+            "m": config["m"],
+            "t": config["t"],
+        }
+    
+    inference_service = InferenceService(configuration_map=inference_config)
 
 

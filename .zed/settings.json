// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "jsx", "-"]
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "ts", "-"]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "tsx", "-"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "json", "-"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "jsonc", "-"]
        }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "deno",
          "arguments": ["fmt", "--ext", "md", "-"]
        }
      }
    }
  }
}

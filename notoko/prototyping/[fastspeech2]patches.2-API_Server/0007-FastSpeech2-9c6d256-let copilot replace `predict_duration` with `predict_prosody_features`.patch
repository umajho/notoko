+def validate_pitch_shape(segments: list[dict[str, Any]], pitch_2d: list[list[float]]) -> tuple[bool, str | None]:
+    """
+    Validate that pitchHz2d shape matches segments structure.
+    
+    Returns:
+        (is_valid, error_message)
+    """
+    if len(segments) != len(pitch_2d):
+        return False, f"pitchHz2d length ({len(pitch_2d)}) does not match segments length ({len(segments)})"
+    
+    for i, (segment, pitches) in enumerate(zip(segments, pitch_2d)):
+        phonemes = segment.get("phonemes", [])
+        if len(phonemes) != len(pitches):
+            return False, f"pitchHz2d[{i}] length ({len(pitches)}) does not match segments[{i}].phonemes length ({len(phonemes)})"
+    
+    return True, None
+
+
+def validate_energy_shape(segments: list[dict[str, Any]], energy_2d: list[list[float]]) -> tuple[bool, str | None]:
+    """
+    Validate that energyZScore2d shape matches segments structure.
+    
+    Returns:
+        (is_valid, error_message)
+    """
+    if len(segments) != len(energy_2d):
+        return False, f"energyZScore2d length ({len(energy_2d)}) does not match segments length ({len(segments)})"
+    
+    for i, (segment, energies) in enumerate(zip(segments, energy_2d)):
+        phonemes = segment.get("phonemes", [])
+        if len(phonemes) != len(energies):
+            return False, f"energyZScore2d[{i}] length ({len(energies)}) does not match segments[{i}].phonemes length ({len(phonemes)})"
+    
+    return True, None
+
+
+def parse_prosody_request(
+    data: dict[str, Any], 
+    override_key: str = "featurePredictions",
+    require_features: bool = False
+) -> tuple[
+    LanguageSpecifier | None,
+    PhonemizeResult | None,
+    list[dict[str, Any]] | None,
+    DurationResult | DurationOptions | None,
+    PitchResult | PitchOptions | None,
+    EnergyResult | EnergyOptions | None,
+    tuple[str, int] | None  # error tuple (message, status_code)
+]:
+    """
+    Parse common prosody request format for both endpoints.
+    
+    Args:
+        data: Request data
+        override_key: Key to look for feature overrides ("featurePredictionOverrides" or "featurePredictions")
+        require_features: If True, all features in the override object are required
+    
+    Returns:
+        (lang_spec, phonemize_result, segments, duration_input, pitch_input, energy_input, error)
+        If error is not None, other values may be None.
+    """
+    # Validate request structure
+    if not data or "specifier" not in data or "phonemeSegments" not in data:
+        return None, None, None, None, None, None, ("missing required fields: specifier, phonemeSegments", 400)
+    
+    # Parse specifier
+    specifier = data["specifier"]
+    lang_iso639_3 = specifier.get("language")
+    phoneme_lexicon = specifier.get("phonemeLexicon")
+    
+    if not lang_iso639_3 or not phoneme_lexicon:
+        return None, None, None, None, None, None, ("specifier must have language and phonemeLexicon", 400)
+    
+    # Validate language and phoneme lexicon
+    is_valid, error_msg = validate_language_and_phoneme_lexicon(lang_iso639_3, phoneme_lexicon)
+    if not is_valid:
+        return None, None, None, None, None, None, (error_msg, 400)
+    
+    # Parse segments
+    segments = data["phonemeSegments"]
+    if not isinstance(segments, list):
+        return None, None, None, None, None, None, ("phonemeSegments must be a list", 400)
+    
+    # Convert to PhonemizeResult
+    phoneme_segments = []
+    for seg in segments:
+        if "text" not in seg or "phonemes" not in seg:
+            return None, None, None, None, None, None, ("each segment must have text and phonemes", 400)
+        phoneme_segments.append(PhonemeSegment(text=seg["text"], phonemes=seg["phonemes"]))
+    
+    phonemize_result = PhonemizeResult(segments=phoneme_segments)
+    
+    # Create LanguageSpecifier
+    lang_spec = LanguageSpecifier(iso639_3=lang_iso639_3, segmentation_format=phoneme_lexicon)
+    
+    # Parse controls (for predict_prosody_features)
+    controls = data.get("controls")
+    speed_control = None
+    pitch_control = None
+    energy_control = None
+    
+    if controls is not None:
+        speed_control = controls.get("speed")
+        pitch_control = controls.get("pitch")
+        energy_control = controls.get("energy")
+    
+    # Parse feature overrides/predictions
+    overrides = data.get(override_key)
+    
+    # Check if features are required
+    if require_features:
+        if overrides is None:
+            return None, None, None, None, None, None, (f"{override_key} is required", 400)
+    
+    duration_input = None
+    pitch_input = None
+    energy_input = None
+    
+    if overrides is not None:
+        # Check if features are required
+        if require_features:
+            if "duration" not in overrides or "pitch" not in overrides or "energy" not in overrides:
+                return None, None, None, None, None, None, (f"all features (duration, pitch, energy) are required in {override_key}", 400)
+        
+        # Parse duration parameter
+        duration_param = overrides.get("duration")
+        if duration_param is not None:
+            # Check mutual exclusivity with controls.speed
+            if speed_control is not None:
+                return None, None, None, None, None, None, ("duration in featurePredictionOverrides and speed in controls are mutually exclusive", 400)
+            
+            if "durationTicks2d" in duration_param and "ticksPerSecond" in duration_param:
+                # DurationResult
+                duration_ticks_2d = duration_param["durationTicks2d"]
+                ticks_per_second = duration_param["ticksPerSecond"]
+                
+                # Validate durations shape
+                is_valid, error_msg = validate_duration_ticks_shape(segments, duration_ticks_2d)
+                if not is_valid:
+                    return None, None, None, None, None, None, (error_msg, 400)
+                
+                # Get config for hop_length
+                lang_code = lang_iso639_3
+                preprocess_config, _, _ = inference_service.configs[lang_code]
+                hop_length = preprocess_config["preprocessing"]["stft"]["hop_length"]
+                
+                # Convert durationTicks2d back to durations2d by dividing by hop_length
+                durations_2d = [
+                    [duration_ticks // hop_length for duration_ticks in segment_durations]
+                    for segment_durations in duration_ticks_2d
+                ]
+                
+                duration_input = DurationResult(
+                    ticks_per_second=ticks_per_second,
+                    durations_2d=durations_2d,
+                    duration_unit_in_ticks=hop_length
+                )
+            else:
+                return None, None, None, None, None, None, ("duration must have durationTicks2d and ticksPerSecond", 400)
+    
+        # Parse pitch parameter
+        pitch_param = overrides.get("pitch")
+        if pitch_param is not None:
+            # Check mutual exclusivity with controls.pitch
+            if pitch_control is not None:
+                return None, None, None, None, None, None, ("pitch in featurePredictionOverrides and pitch in controls are mutually exclusive", 400)
+            
+            if "pitchHz2d" in pitch_param:
+                # PitchResult with frequency in Hz - need to normalize to z-score
+                pitch_2d = pitch_param["pitchHz2d"]
+                
+                # Validate pitch shape
+                is_valid, error_msg = validate_pitch_shape(segments, pitch_2d)
+                if not is_valid:
+                    return None, None, None, None, None, None, (error_msg, 400)
+                
+                # Get stats for normalization
+                lang_code = lang_iso639_3
+                preprocess_config, _, _ = inference_service.configs[lang_code]
+                
+                # Load pitch stats
+                import json
+                stats_path = preprocess_config["path"]["preprocessed_path"] + "/stats.json"
+                with open(stats_path) as f:
+                    stats = json.load(f)
+                    pitch_mean = stats["pitch"][2]
+                    pitch_std = stats["pitch"][3]
+                
+                # Normalize frequency to z-score: (freq - mean) / std
+                pitch_2d = [
+                    [(freq - pitch_mean) / pitch_std for freq in segment_freqs]
+                    for segment_freqs in pitch_2d
+                ]
+                
+                pitch_input = PitchResult(pitch_2d=pitch_2d)
+            else:
+                return None, None, None, None, None, None, ("pitch must have pitchHz2d", 400)
+    
+        # Parse energy parameter
+        energy_param = overrides.get("energy")
+        if energy_param is not None:
+            # Check mutual exclusivity with controls.energy
+            if energy_control is not None:
+                return None, None, None, None, None, None, ("energy in featurePredictionOverrides and energy in controls are mutually exclusive", 400)
+            
+            if "energyZScore2d" in energy_param:
+                # EnergyResult
+                energy_2d = energy_param["energyZScore2d"]
+                
+                # Validate energy shape
+                is_valid, error_msg = validate_energy_shape(segments, energy_2d)
+                if not is_valid:
+                    return None, None, None, None, None, None, (error_msg, 400)
+                
+                energy_input = EnergyResult(energy_2d=energy_2d)
+            else:
+                return None, None, None, None, None, None, ("energy must have energyZScore2d", 400)
+    
+    # Apply controls if no overrides were provided
+    if speed_control is not None and duration_input is None:
+        duration_input = DurationOptions(speed=speed_control)
+    
+    if pitch_control is not None and pitch_input is None:
+        pitch_input = PitchOptions(pitch_control=pitch_control)
+    
+    if energy_control is not None and energy_input is None:
+        energy_input = EnergyOptions(energy_control=energy_control)
+    
+    return lang_spec, phonemize_result, segments, duration_input, pitch_input, energy_input, None
+
+

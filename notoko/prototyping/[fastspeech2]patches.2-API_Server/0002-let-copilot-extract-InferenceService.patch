+def generate_prosody_json_from_infer_result(
+    infer_result,
+    raw_text: str,
+    language: str = "mandarin"
+) -> dict:
+    """
+    Generate prosody JSON from InferResult.
+    
+    Args:
+        infer_result: InferResult from InferenceService.infer_audio()
+        raw_text: Original input text
+        language: Language of the text (default "mandarin")
+        
+    Returns:
+        Dictionary with prosody data
+    """
+    predict_result = infer_result.predict_result
+    
+    # Get phonemes (flatten all segments)
+    all_phonemes = []
+    for segment in predict_result.phonemize_result.segments:
+        all_phonemes.extend(segment.phonemes)
+    
+    # Get durations (flatten 2D to 1D)
+    duration = []
+    for seg_durations in predict_result.duration_result.durations_2d:
+        duration.extend(seg_durations)
+    duration = np.array(duration)
+    
+    # Convert segments to the format expected by generate_prosody_json
+    segments_data = []
+    for segment in predict_result.phonemize_result.segments:
+        # Determine segment type
+        if segment.text.isspace():
+            seg_type = "space"
+        else:
+            seg_type = "text"
+        
+        segments_data.append({
+            "type": seg_type,
+            "text": segment.text,
+            "phonemes": segment.phonemes
+        })
+    
+    # Calculate total audio duration
+    total_duration_ticks = len(infer_result.wav)
+    
+    # Use existing generate_prosody_json function
+    return generate_prosody_json(

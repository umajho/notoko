+"""
+Example script demonstrating how to use the InferenceService.
+
+This shows how to use the refactored InferenceService for text-to-speech synthesis.
+"""
+
+from refactoring import InferenceService, LanguageSpecifier
+from utils.tools import (
+    save_infer_result_audio,
+    save_infer_result_visualization,
+    save_infer_result_prosody,
+)
+
+
+def example_english_synthesis():
+    """Example of English text synthesis."""
+    # Create InferenceService
+    inference_service = InferenceService(
+        configuration_map={
+            "eng": {
+                "restore_step": 900000,
+                "p": "config/LJSpeech/preprocess.yaml",
+                "m": "config/LJSpeech/model.yaml",
+                "t": "config/LJSpeech/train.yaml",
+            }
+        }
+    )
+    
+    # Specify language
+    lang = LanguageSpecifier(
+        iso639_3="eng",
+        segmentation_format="librispeech"
+    )
+    
+    # Input text
+    text = "Hello world, this is a test."
+    
+    # Run inference pipeline
+    print("1. Phonemizing...")
+    phonemize_result = inference_service.phonemize(lang, text)
+    print(f"   Segments: {len(phonemize_result.segments)}")
+    
+    print("2. Predicting duration...")
+    duration_result = inference_service.predict_duration(
+        lang, phonemize_result,
+        duration_control=1.0
+    )
+    
+    print("3. Predicting pitch and energy...")
+    predict_result = inference_service.predict_pitch_and_energy(
+        lang, phonemize_result, duration_result,
+        pitch_control=1.0,
+        energy_control=1.0,
+        duration_control=1.0
+    )
+    
+    print("4. Generating audio...")
+    infer_result = inference_service.infer_audio(lang, predict_result)
+    
+    # Save outputs
+    print("5. Saving outputs...")
+    output_path = "output/result/LJSpeech"
+    stats_path = "preprocessed_data/LJSpeech/stats.json"
+    basename = "example_english"
+    
+    save_infer_result_audio(infer_result, basename, output_path)
+    save_infer_result_visualization(infer_result, basename, output_path, stats_path)
+    save_infer_result_prosody(infer_result, text, basename, output_path, "english")
+    
+    print(f"Done! Files saved to {output_path}/")
+
+
+def example_mandarin_synthesis():
+    """Example of Mandarin text synthesis."""
+    # Create InferenceService
+    inference_service = InferenceService(
+        configuration_map={
+            "cmn": {
+                "speaker_id": 1,
+                "restore_step": 600000,
+                "p": "config/AISHELL3/preprocess.yaml",
+                "m": "config/AISHELL3/model.yaml",
+                "t": "config/AISHELL3/train.yaml",
+            }
+        }
+    )
+    
+    # Specify language
+    lang = LanguageSpecifier(
+        iso639_3="cmn",
+        segmentation_format="fastspeech2-pinyin-r"
+    )
+    
+    # Input text
+    text = "你好，世界！"
+    
+    # Run inference pipeline
+    print("1. Phonemizing...")
+    phonemize_result = inference_service.phonemize(lang, text)
+    print(f"   Segments: {len(phonemize_result.segments)}")
+    
+    print("2. Predicting duration...")
+    duration_result = inference_service.predict_duration(
+        lang, phonemize_result,
+        duration_control=1.0
+    )
+    
+    print("3. Predicting pitch and energy...")
+    predict_result = inference_service.predict_pitch_and_energy(
+        lang, phonemize_result, duration_result,
+        pitch_control=1.0,
+        energy_control=1.0,
+        duration_control=1.0
+    )
+    
+    print("4. Generating audio...")
+    infer_result = inference_service.infer_audio(lang, predict_result)
+    
+    # Save outputs
+    print("5. Saving outputs...")
+    output_path = "output/result/AISHELL3"
+    stats_path = "preprocessed_data/AISHELL3/stats.json"
+    basename = "example_mandarin"
+    
+    save_infer_result_audio(infer_result, basename, output_path)
+    save_infer_result_visualization(infer_result, basename, output_path, stats_path)
+    save_infer_result_prosody(infer_result, text, basename, output_path, "mandarin")
+    
+    print(f"Done! Files saved to {output_path}/")
+
+
+def example_multi_language_service():
+    """Example of InferenceService supporting multiple languages."""
+    # Create InferenceService with both English and Mandarin
+    inference_service = InferenceService(
+        configuration_map={
+            "eng": {
+                "restore_step": 900000,
+                "p": "config/LJSpeech/preprocess.yaml",
+                "m": "config/LJSpeech/model.yaml",
+                "t": "config/LJSpeech/train.yaml",
+            },
+            "cmn": {
+                "speaker_id": 1,
+                "restore_step": 600000,
+                "p": "config/AISHELL3/preprocess.yaml",
+                "m": "config/AISHELL3/model.yaml",
+                "t": "config/AISHELL3/train.yaml",
+            },
+        }
+    )
+    
+    # Synthesize English
+    lang_eng = LanguageSpecifier(iso639_3="eng", segmentation_format="librispeech")
+    phonemize_result_eng = inference_service.phonemize(lang_eng, "Hello")
+    print(f"English phonemes: {phonemize_result_eng.segments[0].phonemes}")
+    
+    # Synthesize Mandarin
+    lang_cmn = LanguageSpecifier(iso639_3="cmn", segmentation_format="fastspeech2-pinyin-r")
+    phonemize_result_cmn = inference_service.phonemize(lang_cmn, "你好")
+    print(f"Mandarin phonemes: {[seg.phonemes for seg in phonemize_result_cmn.segments]}")
+
+
+if __name__ == "__main__":
+    import sys
+    
+    if len(sys.argv) < 2:
+        print("Usage:")
+        print("  python refactoring/example.py english")
+        print("  python refactoring/example.py mandarin")
+        print("  python refactoring/example.py multi")
+        sys.exit(1)
+    
+    mode = sys.argv[1]
+    
+    if mode == "english":
+        example_english_synthesis()
+    elif mode == "mandarin":
+        example_mandarin_synthesis()
+    elif mode == "multi":
+        example_multi_language_service()
+    else:
+        print(f"Unknown mode: {mode}")
+        sys.exit(1)

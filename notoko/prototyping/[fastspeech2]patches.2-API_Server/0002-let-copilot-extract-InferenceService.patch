+"""Type definitions for the InferenceService refactoring."""
+
+from dataclasses import dataclass
+from typing import Literal
+import numpy as np
+
+
+@dataclass
+class LanguageSpecifier:
+    """Specifies the language and segmentation format for phonemization."""
+    iso639_3: str
+    segmentation_format: str
+
+
+@dataclass
+class PhonemeSegment:
+    """A segment of text with its phonemes."""
+    text: str
+    phonemes: list[str]
+
+
+@dataclass
+class PhonemizeResult:
+    """Result of phonemization."""
+    segments: list[PhonemeSegment]
+
+
+@dataclass
+class DurationResult:
+    """Result of duration prediction."""
+    frames_per_second: int
+    durations_2d: list[list[int]]  # Maps to segments->phonemes
+
+
+@dataclass
+class PredictResult:
+    """Result of pitch and energy prediction."""
+    phonemize_result: PhonemizeResult
+    duration_result: DurationResult
+    pitch_predictions: np.ndarray  # Phoneme-level or frame-level pitch predictions
+    energy_predictions: np.ndarray  # Phoneme-level or frame-level energy predictions
+    mel_predictions: np.ndarray  # Predicted mel spectrogram
+    mel_lens: int  # Length of mel spectrogram
+    src_len: int  # Source phoneme sequence length
+    pitch_feature_level: Literal["phoneme_level", "frame_level"]
+    energy_feature_level: Literal["phoneme_level", "frame_level"]
+
+
+@dataclass
+class InferResult:
+    """Result of audio inference."""
+    predict_result: PredictResult
+    wav: np.ndarray  # Generated audio waveform
+    sampling_rate: int
+    hop_length: int
+    actual_pitch: np.ndarray  # Actual pitch extracted from generated audio

+"""Adapters to bridge old and new code."""
+
+import yaml
+import torch
+import numpy as np
+from typing import Any
+
+from utils.model import get_model, get_vocoder, vocoder_infer
+from utils.tools import preprocess_english, preprocess_mandarin, to_device, extract_pitch_from_audio
+from text import text_to_sequence
+from .types import (
+    LanguageSpecifier,
+    PhonemeSegment,
+    PhonemizeResult,
+    DurationResult,
+    PredictResult,
+    InferResult,
+)
+
+device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+
+def load_configs(p: str, m: str, t: str) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+    """Load configuration files."""
+    preprocess_config = yaml.load(open(p, "r"), Loader=yaml.FullLoader)
+    model_config = yaml.load(open(m, "r"), Loader=yaml.FullLoader)
+    train_config = yaml.load(open(t, "r"), Loader=yaml.FullLoader)
+    return preprocess_config, model_config, train_config
+
+
+def phonemize_with_existing_code(
+    lang: LanguageSpecifier, 
+    text: str, 
+    preprocess_config: dict[str, Any]
+) -> PhonemizeResult:
+    """Use existing preprocess_english/preprocess_mandarin to phonemize text."""
+    if lang.iso639_3 == "eng":
+        _, segments_data = preprocess_english(text, preprocess_config, return_segments=True)
+    elif lang.iso639_3 == "cmn":
+        _, segments_data = preprocess_mandarin(text, preprocess_config, return_segments=True)
+    else:
+        raise ValueError(f"Unsupported language: {lang.iso639_3}")
+    
+    # Convert segments_data to PhonemizeResult
+    segments = [
+        PhonemeSegment(text=seg["text"], phonemes=seg["phonemes"])
+        for seg in segments_data
+    ]
+    
+    return PhonemizeResult(segments=segments)
+
+
+def get_phoneme_sequence(phonemize_result: PhonemizeResult, preprocess_config: dict[str, Any]) -> np.ndarray:
+    """Convert PhonemizeResult to phoneme sequence array."""
+    # Flatten all phonemes and convert to sequence format
+    all_phonemes = []
+    for segment in phonemize_result.segments:
+        all_phonemes.extend(segment.phonemes)
+    
+    # Convert to text_to_sequence format
+    phones = "{" + "}{".join(all_phonemes) + "}"
+    phones = phones.replace("}{", " ")
+    
+    sequence = np.array(
+        text_to_sequence(
+            phones, preprocess_config["preprocessing"]["text"]["text_cleaners"]
+        )
+    )
+    
+    return sequence
+
+
+def prepare_model_input(
+    speaker_id: int,
+    phoneme_sequence: np.ndarray,
+    preprocess_config: dict[str, Any]
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, int]:
+    """Prepare input tensors for model inference."""
+    speakers = np.array([speaker_id])
+    texts = np.array([phoneme_sequence])
+    src_lens = np.array([len(phoneme_sequence)])
+    max_src_len = len(phoneme_sequence)
+    
+    # Convert to tensors
+    speakers = torch.from_numpy(speakers).long().to(device)
+    texts = torch.from_numpy(texts).long().to(device)
+    src_lens = torch.from_numpy(src_lens).to(device)
+    
+    return speakers, texts, src_lens, max_src_len
+
+
+def extract_duration_from_output(
+    output: tuple[Any, ...],
+    phonemize_result: PhonemizeResult,
+    sampling_rate: int
+) -> DurationResult:
+    """Extract duration information from model output."""
+    # output[5] is d_rounded (duration predictions)
+    duration_predictions = output[5][0].detach().cpu().numpy()
+    
+    # Convert to 2D structure matching segments->phonemes
+    durations_2d = []
+    phoneme_idx = 0
+    for segment in phonemize_result.segments:
+        segment_durations = []
+        for _ in segment.phonemes:
+            if phoneme_idx < len(duration_predictions):
+                segment_durations.append(int(duration_predictions[phoneme_idx]))
+                phoneme_idx += 1
+        durations_2d.append(segment_durations)
+    
+    return DurationResult(
+        frames_per_second=sampling_rate,
+        durations_2d=durations_2d
+    )
+
+
+def create_predict_result(
+    output: tuple[Any, ...],
+    phonemize_result: PhonemizeResult,
+    duration_result: DurationResult,
+    preprocess_config: dict[str, Any]
+) -> PredictResult:
+    """Create PredictResult from model output."""
+    mel_predictions = output[1][0].detach().cpu().numpy()
+    mel_len = output[9][0].item()
+    src_len = output[8][0].item()
+    
+    pitch_feature = preprocess_config["preprocessing"]["pitch"]["feature"]
+    energy_feature = preprocess_config["preprocessing"]["energy"]["feature"]
+    
+    # output[2] is pitch predictions, output[3] is energy predictions
+    pitch_predictions = output[2][0].detach().cpu().numpy()
+    energy_predictions = output[3][0].detach().cpu().numpy()
+    
+    return PredictResult(
+        phonemize_result=phonemize_result,
+        duration_result=duration_result,
+        pitch_predictions=pitch_predictions,
+        energy_predictions=energy_predictions,
+        mel_predictions=mel_predictions,
+        mel_lens=int(mel_len),
+        src_len=int(src_len),
+        pitch_feature_level=pitch_feature,
+        energy_feature_level=energy_feature
+    )
+
+
+def create_infer_result(
+    predict_result: PredictResult,
+    vocoder: Any,
+    model_config: dict[str, Any],
+    preprocess_config: dict[str, Any]
+) -> InferResult:
+    """Create InferResult by generating audio from mel spectrogram."""
+    # Convert mel predictions to tensor for vocoder
+    mel_tensor = torch.from_numpy(predict_result.mel_predictions).float().unsqueeze(0).to(device)
+    
+    # Generate audio
+    length = predict_result.mel_lens * preprocess_config["preprocessing"]["stft"]["hop_length"]
+    wav_predictions = vocoder_infer(
+        mel_tensor.transpose(1, 2),
+        vocoder,
+        model_config,
+        preprocess_config,
+        lengths=np.array([length])
+    )
+    
+    wav = wav_predictions[0]
+    sampling_rate = preprocess_config["preprocessing"]["audio"]["sampling_rate"]
+    hop_length = preprocess_config["preprocessing"]["stft"]["hop_length"]
+    
+    # Extract actual pitch from generated audio
+    actual_pitch = extract_pitch_from_audio(wav, sampling_rate, ticks_per_point=1)
+    
+    return InferResult(
+        predict_result=predict_result,
+        wav=wav,
+        sampling_rate=sampling_rate,
+        hop_length=hop_length,
+        actual_pitch=actual_pitch
+    )

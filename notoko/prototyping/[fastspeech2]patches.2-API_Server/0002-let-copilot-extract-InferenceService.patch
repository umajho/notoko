+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def verify_types():
+    """Verify that all types are correctly defined and importable."""
+    print("✓ Verifying types...")
+    
+    from refactoring.types import (
+        LanguageSpecifier,
+        PhonemeSegment,
+        PhonemizeResult,
+        DurationResult,
+        PredictResult,
+        InferResult,
+    )
+    
+    # Test LanguageSpecifier
+    lang = LanguageSpecifier(iso639_3="eng", segmentation_format="librispeech")
+    assert lang.iso639_3 == "eng"
+    assert lang.segmentation_format == "librispeech"
+    
+    # Test PhonemeSegment
+    seg = PhonemeSegment(text="hello", phonemes=["HH", "EH1", "L", "OW0"])
+    assert seg.text == "hello"
+    assert len(seg.phonemes) == 4
+    
+    # Test PhonemizeResult
+    phonemize_result = PhonemizeResult(segments=[seg])
+    assert len(phonemize_result.segments) == 1
+    
+    print("  ✓ All types are correctly defined")
+
+
+def verify_imports():
+    """Verify that all exports are accessible."""
+    print("✓ Verifying imports...")
+    
+    from refactoring import (
+        LanguageSpecifier,
+        PhonemeSegment,
+        PhonemizeResult,
+        DurationResult,
+        PredictResult,
+        InferResult,
+        InferenceService,
+    )
+    
+    # Verify InferenceService is a class
+    assert isinstance(InferenceService, type)
+    
+    print("  ✓ All exports are accessible from refactoring package")
+
+
+def verify_adapters():
+    """Verify that adapter functions are defined."""
+    print("✓ Verifying adapters...")
+    
+    from refactoring.adapters import (
+        load_configs,
+        phonemize_with_existing_code,
+        get_phoneme_sequence,
+        prepare_model_input,
+        extract_duration_from_output,
+        create_predict_result,
+        create_infer_result,
+    )
+    
+    # Check that functions are callable
+    assert callable(load_configs)
+    assert callable(phonemize_with_existing_code)
+    assert callable(get_phoneme_sequence)
+    
+    print("  ✓ All adapter functions are defined")
+
+
+def verify_tools_extensions():
+    """Verify that new functions were added to utils/tools.py."""
+    print("✓ Verifying tools extensions...")
+    
+    from utils.tools import (
+        save_predict_result_visualization,
+        save_infer_result_visualization,
+        save_infer_result_audio,
+        generate_prosody_json_from_infer_result,
+        save_infer_result_prosody,
+    )
+    
+    # Check that functions are callable
+    assert callable(save_predict_result_visualization)
+    assert callable(save_infer_result_visualization)
+    assert callable(save_infer_result_audio)
+    assert callable(generate_prosody_json_from_infer_result)
+    assert callable(save_infer_result_prosody)
+    
+    print("  ✓ All new tool functions are defined")
+
+
+def verify_inference_service_structure():
+    """Verify that InferenceService has all required methods."""
+    print("✓ Verifying InferenceService structure...")
+    
+    from refactoring import InferenceService
+    
+    # Check that all required methods exist
+    assert hasattr(InferenceService, '__init__')
+    assert hasattr(InferenceService, 'phonemize')
+    assert hasattr(InferenceService, 'predict_duration')
+    assert hasattr(InferenceService, 'predict_pitch_and_energy')
+    assert hasattr(InferenceService, 'infer_audio')
+    
+    # Check that methods are callable
+    assert callable(getattr(InferenceService, 'phonemize'))
+    assert callable(getattr(InferenceService, 'predict_duration'))
+    assert callable(getattr(InferenceService, 'predict_pitch_and_energy'))
+    assert callable(getattr(InferenceService, 'infer_audio'))
+    
+    print("  ✓ InferenceService has all required methods")
+
+
+def main():
+    """Run all verification checks."""
+    print("\n" + "="*60)
+    print("InferenceService Refactoring Verification")
+    print("="*60 + "\n")
+    
+    try:
+        verify_types()
+        verify_imports()
+        verify_adapters()
+        verify_tools_extensions()
+        verify_inference_service_structure()
+        
+        print("\n" + "="*60)
+        print("✅ All verification checks passed!")
+        print("="*60 + "\n")
+        
+        print("The refactoring is complete and ready to use.")
+        print("\nNext steps:")
+        print("  1. Test with actual models using synthesize.py --use-inference-service")
+        print("  2. Run example.py to see the service in action")
+        print("  3. Read refactoring/README.md for detailed usage")
+        print()
+        
+        return 0
+        
+    except Exception as e:
+        print(f"\n❌ Verification failed: {e}")
+        import traceback
+        traceback.print_exc()
+        return 1
+
+
+if __name__ == "__main__":
+    import sys
+    sys.exit(main())

+"""InferenceService for text-to-speech synthesis."""
+
+import torch
+from typing import Any
+
+from .types import (
+    LanguageSpecifier,
+    PhonemizeResult,
+    DurationResult,
+    PredictResult,
+    InferResult,
+)
+from .adapters import (
+    load_configs,
+    phonemize_with_existing_code,
+    get_phoneme_sequence,
+    prepare_model_input,
+    extract_duration_from_output,
+    create_predict_result,
+    create_infer_result,
+)
+from utils.model import get_model, get_vocoder
+
+device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+
+class InferenceService:
+    """Service for text-to-speech inference."""
+    
+    def __init__(self, configuration_map: dict[str, dict[str, Any]]):
+        """
+        Initialize InferenceService with configuration for multiple languages.
+        
+        Args:
+            configuration_map: Dictionary mapping language codes to config dictionaries.
+                Each config dictionary should have:
+                - "restore_step": int
+                - "p": path to preprocess.yaml
+                - "m": path to model.yaml
+                - "t": path to train.yaml
+                - "speaker_id": int (optional, default 0)
+        """
+        self.configuration_map = configuration_map
+        self.models: dict[str, Any] = {}
+        self.vocoders: dict[str, Any] = {}
+        self.configs: dict[str, tuple[dict, dict, dict]] = {}
+        
+        # Load models and configs for each language
+        for lang_code, config in configuration_map.items():
+            preprocess_config, model_config, train_config = load_configs(
+                config["p"], config["m"], config["t"]
+            )
+            self.configs[lang_code] = (preprocess_config, model_config, train_config)
+            
+            # Create a simple args object for get_model
+            class Args:
+                def __init__(self, restore_step: int):
+                    self.restore_step = restore_step
+            
+            args = Args(config["restore_step"])
+            model = get_model(args, (preprocess_config, model_config, train_config), device, train=False)
+            self.models[lang_code] = model
+            
+            # Load vocoder (can be shared across languages with same vocoder config)
+            vocoder = get_vocoder(model_config, device)
+            self.vocoders[lang_code] = vocoder
+    
+    def _get_lang_code(self, lang: LanguageSpecifier) -> str:
+        """Map LanguageSpecifier to configuration key."""
+        return lang.iso639_3
+    
+    def _get_speaker_id(self, lang: LanguageSpecifier) -> int:
+        """Get speaker ID for the given language."""
+        lang_code = self._get_lang_code(lang)
+        return self.configuration_map[lang_code].get("speaker_id", 0)
+    
+    def phonemize(self, lang: LanguageSpecifier, text: str) -> PhonemizeResult:
+        """
+        Convert text to phonemes.
+        
+        Args:
+            lang: Language specifier with iso639-3 code and segmentation format
+            text: Input text to phonemize
+            
+        Returns:
+            PhonemizeResult with segments containing text and phonemes
+        """
+        lang_code = self._get_lang_code(lang)
+        preprocess_config, _, _ = self.configs[lang_code]
+        
+        return phonemize_with_existing_code(lang, text, preprocess_config)
+    
+    def predict_duration(
+        self, 
+        lang: LanguageSpecifier, 
+        phonemize_result: PhonemizeResult, 
+        **opts: Any
+    ) -> DurationResult:
+        """
+        Predict duration for each phoneme.
+        
+        Args:
+            lang: Language specifier
+            phonemize_result: Result from phonemize()
+            **opts: Optional control parameters
+                - duration_control: float, control speaking speed (default 1.0)
+                
+        Returns:
+            DurationResult with frames_per_second and durations_2d
+        """
+        lang_code = self._get_lang_code(lang)
+        preprocess_config, model_config, train_config = self.configs[lang_code]
+        model = self.models[lang_code]
+        speaker_id = self._get_speaker_id(lang)
+        
+        duration_control = opts.get("duration_control", 1.0)
+        
+        # Get phoneme sequence
+        phoneme_sequence = get_phoneme_sequence(phonemize_result, preprocess_config)
+        
+        # Prepare model input
+        speakers, texts, src_lens, max_src_len = prepare_model_input(
+            speaker_id, phoneme_sequence, preprocess_config
+        )
+        
+        # Run model forward pass with duration control
+        with torch.no_grad():
+            output = model(
+                speakers, texts, src_lens, max_src_len,
+                d_control=duration_control
+            )
+        
+        # Extract duration from output
+        sampling_rate = preprocess_config["preprocessing"]["audio"]["sampling_rate"]
+        return extract_duration_from_output(output, phonemize_result, sampling_rate)
+    
+    def predict_pitch_and_energy(
+        self,
+        lang: LanguageSpecifier,
+        phonemize_result: PhonemizeResult,
+        duration_result: DurationResult,
+        **opts: Any
+    ) -> PredictResult:
+        """
+        Predict pitch and energy.
+        
+        Args:
+            lang: Language specifier
+            phonemize_result: Result from phonemize()
+            duration_result: Result from predict_duration()
+            **opts: Optional control parameters
+                - pitch_control: float, control pitch (default 1.0)
+                - energy_control: float, control energy (default 1.0)
+                - duration_control: float, control speaking speed (default 1.0)
+                
+        Returns:
+            PredictResult with all prediction data
+        """
+        lang_code = self._get_lang_code(lang)
+        preprocess_config, model_config, train_config = self.configs[lang_code]
+        model = self.models[lang_code]
+        speaker_id = self._get_speaker_id(lang)
+        
+        pitch_control = opts.get("pitch_control", 1.0)
+        energy_control = opts.get("energy_control", 1.0)
+        duration_control = opts.get("duration_control", 1.0)
+        
+        # Get phoneme sequence
+        phoneme_sequence = get_phoneme_sequence(phonemize_result, preprocess_config)
+        
+        # Prepare model input
+        speakers, texts, src_lens, max_src_len = prepare_model_input(
+            speaker_id, phoneme_sequence, preprocess_config
+        )
+        
+        # Run model forward pass with all controls
+        with torch.no_grad():
+            output = model(
+                speakers, texts, src_lens, max_src_len,
+                p_control=pitch_control,
+                e_control=energy_control,
+                d_control=duration_control
+            )
+        
+        # Create PredictResult from output
+        return create_predict_result(output, phonemize_result, duration_result, preprocess_config)
+    
+    def infer_audio(
+        self,
+        lang: LanguageSpecifier,
+        predict_result: PredictResult
+    ) -> InferResult:
+        """
+        Generate audio from predictions.
+        
+        Args:
+            lang: Language specifier
+            predict_result: Result from predict_pitch_and_energy()
+            
+        Returns:
+            InferResult with generated audio and metadata
+        """
+        lang_code = self._get_lang_code(lang)
+        preprocess_config, model_config, _ = self.configs[lang_code]
+        vocoder = self.vocoders[lang_code]
+        
+        return create_infer_result(predict_result, vocoder, model_config, preprocess_config)

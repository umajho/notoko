+"""Flask API server for FastSpeech2 inference service."""
+
+from flask import Flask, request, jsonify
+from typing import Any
+import numpy as np
+
+from refactoring import InferenceService, LanguageSpecifier, PhonemizeResult, PhonemeSegment, DurationResult
+from utils.tools import generate_prosody_json
+
+app = Flask(__name__)
+
+# Initialize InferenceService with default configurations
+# This will be initialized when the server starts
+inference_service: InferenceService | None = None
+
+
+def validate_language_and_segmentation(lang_iso639: str, seg_format: str) -> tuple[bool, str | None]:
+    """
+    Validate language and segmentation format compatibility.
+    
+    Returns:
+        (is_valid, error_message)
+    """
+    # Define valid combinations
+    valid_combinations = {
+        "eng": ["librispeech"],
+        "cmn": ["fastspeech2-pinyin-r"]
+    }
+    
+    if lang_iso639 not in valid_combinations:
+        return False, f"unsupported language `{lang_iso639}`"
+    
+    if seg_format not in valid_combinations[lang_iso639]:
+        return False, f"unsupported segmentation format `{seg_format}` for language `{lang_iso639}`"
+    
+    return True, None
+
+
+def validate_durations_shape(segments: list[dict[str, Any]], durations_2d: list[list[int]]) -> tuple[bool, str | None]:
+    """
+    Validate that durations_2d shape matches segments structure.
+    
+    Returns:
+        (is_valid, error_message)
+    """
+    if len(segments) != len(durations_2d):
+        return False, f"durations_2d length ({len(durations_2d)}) does not match segments length ({len(segments)})"
+    
+    for i, (segment, durations) in enumerate(zip(segments, durations_2d)):
+        phonemes = segment.get("phonemes", [])
+        if len(phonemes) != len(durations):
+            return False, f"durations_2d[{i}] length ({len(durations)}) does not match segments[{i}].phonemes length ({len(phonemes)})"
+    
+    return True, None
+
+
+@app.route("/predict_duration", methods=["POST"])
+def predict_duration():
+    """Predict duration for phoneme segments."""
+    try:
+        data = request.get_json()
+        
+        # Validate request structure
+        if not data or "language" not in data or "segments" not in data:
+            return jsonify(["error", {"message": "missing required fields: language, segments"}]), 400
+        
+        # Parse language
+        language = data["language"]
+        lang_iso639 = language.get("iso-639")
+        seg_format = language.get("segmentation_format")
+        
+        if not lang_iso639 or not seg_format:
+            return jsonify(["error", {"message": "language must have iso-639 and segmentation_format"}]), 400
+        
+        # Validate language and segmentation format
+        is_valid, error_msg = validate_language_and_segmentation(lang_iso639, seg_format)
+        if not is_valid:
+            return jsonify(["error", {"message": error_msg}]), 400
+        
+        # Parse segments
+        segments = data["segments"]
+        if not isinstance(segments, list):
+            return jsonify(["error", {"message": "segments must be a list"}]), 400
+        
+        # Convert to PhonemizeResult
+        phoneme_segments = []
+        for seg in segments:
+            if "text" not in seg or "phonemes" not in seg:
+                return jsonify(["error", {"message": "each segment must have text and phonemes"}]), 400
+            phoneme_segments.append(PhonemeSegment(text=seg["text"], phonemes=seg["phonemes"]))
+        
+        phonemize_result = PhonemizeResult(segments=phoneme_segments)
+        
+        # Create LanguageSpecifier
+        lang_spec = LanguageSpecifier(iso639_3=lang_iso639, segmentation_format=seg_format)
+        
+        # Call inference service
+        duration_result = inference_service.predict_duration(lang_spec, phonemize_result)
+        
+        # Format response
+        response = {
+            "ticksPerSecond": duration_result.ticks_per_second,
+            "durations2d": duration_result.durations_2d,
+            "durationUnitInTicks": duration_result.duration_unit_in_ticks
+        }
+        
+        return jsonify(["ok", response]), 200
+        
+    except Exception as e:
+        return jsonify(["error", {"message": f"internal error: {str(e)}"}]), 500
+
+
+@app.route("/generate_prosody", methods=["POST"])
+def generate_prosody():
+    """Generate prosody data from phoneme segments and optional durations."""
+    try:
+        data = request.get_json()
+        
+        # Validate request structure
+        if not data or "language" not in data or "segments" not in data:
+            return jsonify(["error", {"message": "missing required fields: language, segments"}]), 400
+        
+        # Parse language
+        language = data["language"]
+        lang_iso639 = language.get("iso-639")
+        seg_format = language.get("segmentation_format")
+        
+        if not lang_iso639 or not seg_format:
+            return jsonify(["error", {"message": "language must have iso-639 and segmentation_format"}]), 400
+        
+        # Validate language and segmentation format
+        is_valid, error_msg = validate_language_and_segmentation(lang_iso639, seg_format)
+        if not is_valid:
+            return jsonify(["error", {"message": error_msg}]), 400
+        
+        # Parse segments
+        segments = data["segments"]
+        if not isinstance(segments, list):
+            return jsonify(["error", {"message": "segments must be a list"}]), 400
+        
+        # Convert to PhonemizeResult
+        phoneme_segments = []
+        for seg in segments:
+            if "text" not in seg or "phonemes" not in seg:
+                return jsonify(["error", {"message": "each segment must have text and phonemes"}]), 400
+            phoneme_segments.append(PhonemeSegment(text=seg["text"], phonemes=seg["phonemes"]))
+        
+        phonemize_result = PhonemizeResult(segments=phoneme_segments)
+        
+        # Create LanguageSpecifier
+        lang_spec = LanguageSpecifier(iso639_3=lang_iso639, segmentation_format=seg_format)
+        
+        # Get or predict durations
+        durations_2d = data.get("durations2d")
+        
+        if durations_2d is not None:
+            # Validate durations shape
+            is_valid, error_msg = validate_durations_shape(segments, durations_2d)
+            if not is_valid:
+                return jsonify(["error", {"message": error_msg}]), 400
+            
+            # Get config for frames_per_second and hop_length
+            lang_code = lang_iso639
+            preprocess_config, _, _ = inference_service.configs[lang_code]
+            frames_per_second = preprocess_config["preprocessing"]["audio"]["sampling_rate"]
+            hop_length = preprocess_config["preprocessing"]["stft"]["hop_length"]
+            
+            # Create DurationResult from provided durations
+            duration_result = DurationResult(
+                ticks_per_second=frames_per_second,
+                durations_2d=durations_2d,
+                duration_unit_in_ticks=hop_length
+            )
+        else:
+            # Predict durations using inference service
+            duration_result = inference_service.predict_duration(lang_spec, phonemize_result)
+        
+        # Predict pitch and energy
+        predict_result = inference_service.predict_pitch_and_energy(
+            lang_spec, phonemize_result, duration_result
+        )
+        
+        # Infer audio to get actual pitch
+        infer_result = inference_service.infer_audio(lang_spec, predict_result)
+        
+        # Prepare data for generate_prosody_json
+        # Flatten all phonemes
+        all_phonemes = []
+        for segment in phonemize_result.segments:
+            all_phonemes.extend(segment.phonemes)
+        
+        # Flatten durations
+        all_durations = []
+        for seg_durations in duration_result.durations_2d:
+            all_durations.extend(seg_durations)
+        all_durations = np.array(all_durations)
+        
+        # Convert segments to format expected by generate_prosody_json
+        segments_data = []
+        for segment in phonemize_result.segments:
+            segments_data.append({
+                "text": segment.text,
+                "phonemes": segment.phonemes
+            })
+        
+        # Reconstruct raw text from segments
+        raw_text = "".join(seg.text for seg in phonemize_result.segments)
+        
+        # Determine language name
+        language_name = "mandarin" if lang_iso639 == "cmn" else "english"
+        
+        # Generate prosody JSON
+        prosody_data = generate_prosody_json(
+            raw_text=raw_text,
+            phonemes=all_phonemes,
+            durations=all_durations,
+            actual_pitch=infer_result.actual_pitch,
+            hop_length=infer_result.hop_length,
+            sampling_rate=infer_result.sampling_rate,
+            segments_data=segments_data,
+            ticks_per_point=1,
+            language=language_name,
+        )
+        
+        return jsonify(["ok", prosody_data]), 200
+        
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        return jsonify(["error", {"message": f"internal error: {str(e)}"}]), 500
+
+
+def initialize_service(config_map: dict[str, dict[str, Any]]):
+    """Initialize the inference service with configuration."""
+    global inference_service
+    inference_service = InferenceService(configuration_map=config_map)
+
+
+if __name__ == "__main__":
+    import argparse
+    
+    parser = argparse.ArgumentParser(description="FastSpeech2 API Server")
+    parser.add_argument("--host", type=str, default="127.0.0.1", help="Host to bind to")
+    parser.add_argument("--port", type=int, default=11111, help="Port to bind to")
+    parser.add_argument("--debug", action="store_true", help="Enable debug mode")
+    
+    args = parser.parse_args()
+    
+    # Build configuration map
+    config_map = {
+      # "eng": {
+      #   "restore_step": 900000,
+      #   "p": "config/LJSpeech/preprocess.yaml",
+      #   "m": "config/LJSpeech/model.yaml",
+      #   "t": "config/LJSpeech/train.yaml",
+      # },
+      "cmn": {
+        "speaker_id": 1,
+        "restore_step": 600000,
+        "p": "config/AISHELL3/preprocess.yaml",
+        "m": "config/AISHELL3/model.yaml",
+        "t": "config/AISHELL3/train.yaml",
+      },
+    }
+    
+    print("Initializing InferenceService...")
+    initialize_service(config_map)
+    print("InferenceService initialized successfully!")
+    
+    print(f"Starting server on {args.host}:{args.port}")
+    app.run(host=args.host, port=args.port, debug=args.debug)
